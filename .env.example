# ============================================================
# SLR-Nexus — Variables d'environnement
# Copier ce fichier vers .env et remplir les valeurs réelles
# JAMAIS committer .env dans Git — il contient des secrets
# ============================================================

# --- Environnement ---
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- PostgreSQL ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=slr_nexus
POSTGRES_USER=slr_user
POSTGRES_PASSWORD=changeme
# Optional full URL override; normally leave blank to build it from POSTGRES_* above.
DATABASE_URL=

# --- Qdrant ---
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=
QDRANT_CHUNKS_COLLECTION=chunks
QDRANT_MEMORY_COLLECTION=semantic_memory
EMBEDDING_VECTOR_SIZE=384

# --- Neo4j (Phase 6+) — décommenter quand nécessaire ---
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USERNAME=neo4j
# NEO4J_PASSWORD=changeme

# --- Ollama (LLM local par défaut) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DEFAULT_MODEL=llama3.2:3b

# --- Groq (LLM distant, fallback) ---
GROQ_API_KEY=your_groq_api_key_here
GROQ_DEFAULT_MODEL=llama-3.1-8b-instant

# --- APIs scientifiques ---
SEMANTIC_SCHOLAR_API_KEY=
CROSSREF_EMAIL=your_email@example.com
OPENALEX_BASE_URL=https://api.openalex.org
CROSSREF_BASE_URL=https://api.crossref.org
SEMANTIC_SCHOLAR_BASE_URL=https://api.semanticscholar.org/graph/v1
SCIENTIFIC_API_MAX_RETRIES=4
SCIENTIFIC_API_BACKOFF_SECONDS=0.5

# --- Workflow ---
MAX_TOKENS_PER_WORKFLOW=100000
MAX_REVISIONS=3
SCREENING_CONFIDENCE_THRESHOLD=0.6
HUMAN_REVIEW_TIMEOUT_SCREENING_HOURS=24
HUMAN_REVIEW_TIMEOUT_NEO4J_HOURS=1

# --- LLM Fallback ---
LLM_MAX_REPAIR_ATTEMPTS=2
LLM_RETRY_DELAY_SECONDS=1.0
LLM_TIMEOUT_SECONDS=60

# --- Retrieval ---
RETRIEVAL_TOP_K=20
CHUNK_SIZE_TOKENS=512
CHUNK_OVERLAP_TOKENS=64
MIN_CHUNK_TOKENS=100
